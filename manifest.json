{
  "manifest_version": 3,
  "name": "MetaTruth \u2014 Bones & Remedy",
  "version": "0.4.0",
  "description": "Evidence-first meta search, provenance capture, Remedy review, and staged audit deployment.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "MetaTruth",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "admin.html"
}